<?php

// Generated by Starter Package

namespace App\Filament\Resources;

use App\Filament\Resources\Concerns\HasSeoFormFields;
use App\Filament\Resources\BlogPostResource\Pages;
use App\Models\BlogAuthor;
use App\Models\BlogPost;
use App\Models\SiteSeo;
use Filament\Actions\Action;
use Filament\Actions\DeleteBulkAction;
use Filament\Actions\EditAction;
use Filament\Actions\ForceDeleteBulkAction;
use Filament\Actions\RestoreBulkAction;
use Filament\Forms\Components\DateTimePicker;
use Filament\Forms\Components\RichEditor;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\SpatieMediaLibraryFileUpload;
use Filament\Forms\Components\Textarea;
use Filament\Forms\Components\TextInput;
use Filament\Forms\Components\Toggle;
use Filament\Schemas\Schema;
use Filament\Schemas\Components\Tabs;
use Filament\Schemas\Components\Tabs\Tab;
use Filament\Resources\Resource;
use Filament\Tables\Columns\TextColumn;
use Filament\Tables\Filters\SelectFilter;
use Filament\Tables\Filters\TernaryFilter;
use Filament\Tables\Filters\TrashedFilter;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Support\Str;

class BlogPostResource extends Resource
{
    use HasSeoFormFields;

    protected static ?string $model = BlogPost::class;

    protected static string|\BackedEnum|null $navigationIcon = 'heroicon-o-document-text';

    protected static ?string $navigationLabel = 'Blog Posts';

    protected static string|\UnitEnum|null $navigationGroup = 'Blog';

    public static function form(Schema $schema): Schema
    {
        return $schema
            ->schema([
                Tabs::make('BlogPostTabs')
                    ->tabs([
                        Tab::make('Content')
                            ->schema([
                                TextInput::make('title')
                                    ->required()
                                    ->live(debounce: 500)
                                    ->afterStateUpdated(fn ($state, callable $set) => $set('slug', Str::slug((string) $state)))
                                    ->columnSpanFull(),
                                TextInput::make('slug')
                                    ->required()
                                    ->unique(ignoreRecord: true)
                                    ->columnSpanFull(),
                                Select::make('blog_author_id')
                                    ->label('Author')
                                    ->options(BlogAuthor::query()->pluck('name', 'id'))
                                    ->searchable()
                                    ->preload(),
                                Textarea::make('excerpt')
                                    ->rows(3)
                                    ->columnSpanFull(),
                                RichEditor::make('content')
                                    ->extraInputAttributes(['style' => 'min-height: 20rem;'])
                                    ->columnSpanFull(),
                            ]),
                        Tab::make('Media')
                            ->schema([
                                SpatieMediaLibraryFileUpload::make('cover')
                                    ->collection('cover')
                                    ->image()
                                    ->columnSpanFull(),
                            ]),
                        Tab::make('Publishing')
                            ->schema([
                                Toggle::make('is_published')
                                    ->label('Published'),
                                DateTimePicker::make('published_at')
                                    ->label('Published at'),
                            ]),
                        Tab::make('SEO')
                            ->schema(static::seoTabSchema()),
                    ])
                    ->columnSpanFull(),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('title')
                    ->searchable()
                    ->sortable(),
                TextColumn::make('author.name')
                    ->label('Author')
                    ->sortable(),
                TextColumn::make('is_published')
                    ->badge()
                    ->label('Status')
                    ->formatStateUsing(fn (bool $state): string => $state ? 'Published' : 'Draft'),
                TextColumn::make('published_at')
                    ->dateTime()
                    ->sortable(),
                TextColumn::make('updated_at')
                    ->dateTime()
                    ->sortable(),
            ])
            ->recordActions([
                EditAction::make(),
                Action::make('seo')
                    ->label('Edit SEO')
                    ->url(function (BlogPost $record): ?string {
                        if (! class_exists(SiteSeo::class) || ! class_exists(SiteSeoResource::class)) {
                            return null;
                        }

                        $seoId = SiteSeo::query()
                            ->where('seoable_type', BlogPost::class)
                            ->where('seoable_id', $record->getKey())
                            ->value('id');

                        if (! is_numeric($seoId)) {
                            return null;
                        }

                        return SiteSeoResource::getUrl('edit', ['record' => (int) $seoId]);
                    })
                    ->visible(fn (): bool => class_exists(SiteSeo::class) && class_exists(SiteSeoResource::class)),
                Action::make('preview')
                    ->label('Preview')
                    ->url(fn (BlogPost $record): string => route('blog.show', $record->slug))
                    ->openUrlInNewTab(),
            ])
            ->filters([
                TernaryFilter::make('is_published')
                    ->label('Published'),
                SelectFilter::make('blog_author_id')
                    ->label('Author')
                    ->options(BlogAuthor::query()->pluck('name', 'id')),
                TrashedFilter::make(),
            ])
            ->toolbarActions([
                DeleteBulkAction::make(),
                ForceDeleteBulkAction::make(),
                RestoreBulkAction::make(),
            ]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListBlogPosts::route('/'),
            'create' => Pages\CreateBlogPost::route('/create'),
            'edit' => Pages\EditBlogPost::route('/{record}/edit'),
        ];
    }

    public static function getEloquentQuery(): Builder
    {
        return parent::getEloquentQuery()->withoutGlobalScopes([
            \Illuminate\Database\Eloquent\SoftDeletingScope::class,
        ]);
    }

    protected static function seoDescriptionHelperText(): ?string
    {
        return 'Defaults to excerpt when empty.';
    }
}
