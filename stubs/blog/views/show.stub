{{-- Generated by Starter Package --}}
<x-layout>
    @push('seo')
        <title>{{ $post->meta_title ?: $post->title }}</title>
        <meta name="description" content="{{ $post->meta_description ?: ($post->excerpt ?? '') }}">
        @if (is_array($post->meta_keywords) && count($post->meta_keywords) > 0)
            <meta name="keywords" content="{{ implode(',', $post->meta_keywords) }}">
        @endif
        @php
            $ogUrl = $post->getFirstMediaUrl('og') ?: $post->getFirstMediaUrl('cover');
        @endphp
        @if ($ogUrl)
            <meta property="og:image" content="{{ $ogUrl }}">
        @endif
        @if ($post->meta_structure)
            @php
                $schemas = $post->meta_structure;
                $schemaList = is_array($schemas) && array_is_list($schemas) ? $schemas : [$schemas];
            @endphp
            @foreach ($schemaList as $schema)
                @php
                    $schemaJson = is_string($schema)
                        ? $schema
                        : json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
                @endphp
                @if ($schemaJson)
                    <script type="application/ld+json">
                        {!! $schemaJson !!}
                    </script>
                @endif
            @endforeach
        @endif
    @endpush

    <article>
        <h1>{{ $post->title }}</h1>
        @if ($post->excerpt)
            <p>{{ $post->excerpt }}</p>
        @endif
        <div>
            {!! $post->content !!}
        </div>
    </article>
</x-layout>
