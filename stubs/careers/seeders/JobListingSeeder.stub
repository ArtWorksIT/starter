<?php

// Generated by Starter Package

namespace Database\Seeders;

use App\Models\JobListing;
use Illuminate\Database\Seeder;

class JobListingSeeder extends Seeder
{
    public function run(): void
    {
        $jobs = JobListing::factory(10)->create();

        // Populate SEO relation for each listing if the SEO module is installed
        if (! class_exists(\App\Models\SiteSeo::class)) {
            return;
        }

        $jobs->each(function (JobListing $job): void {
            if (! $job->seo) {
                return;
            }

            $job->seo->update([
                'meta_title' => $job->title,
                'meta_description' => trim($job->experience . ' ' . $job->job_type . ' position' . ($job->job_location ? ' — ' . $job->job_location : '') . '.'),
            ]);
        });
    }
}
