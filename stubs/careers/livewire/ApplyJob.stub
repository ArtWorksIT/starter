<?php

// Generated by Starter Package

namespace App\Livewire\Careers;

use App\Models\JobListing;
use App\Models\JobSubmission;
use Livewire\Component;
use Livewire\WithFileUploads;

class ApplyJob extends Component
{
    use WithFileUploads;

    public JobListing $job;

    public string $fullName = '';

    public string $email = '';

    public ?string $phone = null;

    public ?string $coverLetter = null;

    public mixed $cv = null;

    public function mount(string $slug): void
    {
        $this->job = JobListing::query()
            ->where('slug', $slug)
            ->publishedOrFail();
    }

    public function submit(): void
    {
        $data = $this->validate([
            'fullName' => ['required', 'string', 'max:255'],
            'email' => ['required', 'email', 'max:255'],
            'phone' => ['nullable', 'string', 'max:50'],
            'coverLetter' => ['nullable', 'string'],
            'cv' => ['nullable', 'file', 'max:5120'],
        ]);

        $submission = JobSubmission::query()->create([
            'job_listing_id' => $this->job->id,
            'full_name' => $data['fullName'],
            'email' => $data['email'],
            'phone' => $data['phone'],
            'cover_letter' => $data['coverLetter'],
        ]);

        if ($this->cv) {
            $submission->addMedia($this->cv->getRealPath())
                ->usingFileName($this->cv->getClientOriginalName())
                ->toMediaCollection('cv');
        }

        $this->reset(['fullName', 'email', 'phone', 'coverLetter', 'cv']);

        session()->flash('status', 'Application submitted successfully.');
    }

    public function render()
    {
        return view('livewire.careers.apply-job');
    }
}
