<?php

// Generated by Starter Package

namespace App\Filament\Resources;

use App\Filament\Resources\JobSubmissionResource\Pages;
use App\Models\JobSubmission;
use Filament\Actions\Action;
use Filament\Actions\ViewAction;
use Filament\Actions\DeleteBulkAction;
use Filament\Actions\ForceDeleteBulkAction;
use Filament\Actions\RestoreBulkAction;
use Filament\Tables\Columns\TextColumn;
use Filament\Infolists\Components\TextEntry;
use Filament\Resources\Resource;
use Filament\Schemas\Schema;
use Filament\Tables\Filters\SelectFilter;
use Filament\Tables\Filters\TrashedFilter;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Builder;
use Spatie\MediaLibrary\MediaCollections\Models\Media;

class JobSubmissionResource extends Resource
{
    protected static ?string $model = JobSubmission::class;

    private static function cvMedia(JobSubmission $record): ?Media
    {
        return $record->getFirstMedia('cv');
    }

    private static function downloadCvAction(): Action
    {
        return Action::make('downloadCv')
            ->label('Download CV')
            ->action(function (JobSubmission $record) {
                $media = static::cvMedia($record);

                if (! $media instanceof Media) {
                    return null;
                }

                return response()->download($media->getPath(), $media->file_name);
            })
            ->visible(fn (JobSubmission $record): bool => static::cvMedia($record) instanceof Media);
    }

    protected static string|\BackedEnum|null $navigationIcon = 'heroicon-o-inbox';

    protected static ?string $navigationLabel = 'Job Submissions';

    protected static string|\UnitEnum|null $navigationGroup = 'Careers';

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('jobListing.title')
                    ->label('Job')
                    ->searchable(),
                TextColumn::make('full_name')
                    ->searchable(),
                TextColumn::make('email')
                    ->searchable(),
                TextColumn::make('status')
                    ->badge(),
                TextColumn::make('created_at')
                    ->dateTime(),
            ])
            ->recordActions([
                ViewAction::make(),
                static::downloadCvAction(),
                Action::make('markReviewed')
                    ->label('Mark reviewed')
                    ->action(function (JobSubmission $record): void {
                        $record->update(['status' => 'reviewed']);
                    })
                    ->visible(fn (JobSubmission $record): bool => $record->status !== 'reviewed'),
                Action::make('markRejected')
                    ->label('Mark rejected')
                    ->action(function (JobSubmission $record): void {
                        $record->update(['status' => 'rejected']);
                    })
                    ->visible(fn (JobSubmission $record): bool => $record->status !== 'rejected'),
            ])
            ->filters([
                SelectFilter::make('job_listing_id')
                    ->label('Job')
                    ->relationship('jobListing', 'title'),
                SelectFilter::make('status')
                    ->options([
                        'new' => 'New',
                        'reviewed' => 'Reviewed',
                        'shortlisted' => 'Shortlisted',
                        'rejected' => 'Rejected',
                    ]),
                TrashedFilter::make(),
            ])
            ->toolbarActions([
                DeleteBulkAction::make(),
                ForceDeleteBulkAction::make(),
                RestoreBulkAction::make(),
            ]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListJobSubmissions::route('/'),
            'view' => Pages\ViewJobSubmission::route('/{record}'),
        ];
    }

    public static function getEloquentQuery(): Builder
    {
        return parent::getEloquentQuery()->withoutGlobalScopes([
            \Illuminate\Database\Eloquent\SoftDeletingScope::class,
        ]);
    }

    public static function infolist(Schema $schema): Schema
    {
        return $schema
            ->schema([
                TextEntry::make('jobListing.title')
                    ->label('Job'),
                TextEntry::make('full_name')
                    ->label('Full name'),
                TextEntry::make('email'),
                TextEntry::make('phone'),
            TextEntry::make('cover_letter')
                ->columnSpanFull(),
            TextEntry::make("cv")
                ->label("CV")
                ->state(fn (JobSubmission $record): string => static::cvMedia($record)?->file_name ?? 'No file uploaded')
                ->hidden(fn (JobSubmission $record): bool => ! (static::cvMedia($record) instanceof Media)),
            TextEntry::make('status'),
            TextEntry::make('notes')
                ->columnSpanFull(),

            ]);
    }
}
