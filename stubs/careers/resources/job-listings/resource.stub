class JobListingResource extends Resource
{
    use HasSeoFormFields;

    protected static ?string $model = JobListing::class;

    protected static string|\BackedEnum|null $navigationIcon = 'heroicon-o-briefcase';

    protected static ?string $navigationLabel = 'Job Listings';

    protected static string|\UnitEnum|null $navigationGroup = 'Careers';

    public static function form(Schema $schema): Schema
    {
        return $schema
            ->schema([
                Tabs::make('JobListingTabs')
                    ->tabs([
                        Tab::make('Details')
                            ->schema([
                                TextInput::make('title')
                                    ->required()
                                    ->live(debounce: 500)
                                    ->afterStateUpdated(fn ($state, callable $set) => $set('slug', Str::slug((string) $state)))
                                    ->columnSpanFull(),
                                TextInput::make('slug')
                                    ->required()
                                    ->unique(ignoreRecord: true)
                                    ->columnSpanFull(),
                                TextInput::make('experience'),
                                TextInput::make('job_location')
                                    ->label('Location'),
                                Select::make('job_type')
                                    ->options([
                                        'full-time' => 'Full-time',
                                        'part-time' => 'Part-time',
                                        'contract' => 'Contract',
                                        'remote' => 'Remote',
                                    ]),
                                TextInput::make('external_link')
                                    ->label('External link')
                                    ->url()
                                    {{ externalLinkRequired }}
                                    ->columnSpanFull(),
                            ]),
                        Tab::make('Description')
                            ->schema([
                                RichEditor::make('description')
                                    ->extraInputAttributes(['style' => 'min-height: 20rem;'])
                                    ->columnSpanFull(),
                            ]),
                        Tab::make('SEO')
                            ->schema(static::seoTabSchema()),
                    ])
                    ->columnSpanFull(),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                TextColumn::make('title')
                    ->searchable()
                    ->sortable(),
                TextColumn::make('job_type')
                    ->label('Type')
                    ->sortable(),
                TextColumn::make('job_location')
                    ->label('Location')
                    ->sortable(),
                TextColumn::make('updated_at')
                    ->dateTime()
                    ->sortable(),
            ])
            ->reorderable('sort_order')
            ->recordActions([
                EditAction::make(),
                \Artworksit\Starter\Filament\Actions\TogglePublishAction::make(),
                Action::make('seo')
                    ->label('Edit SEO')
                    ->url(function (JobListing $record): ?string {
                        if (! class_exists(SiteSeo::class) || ! class_exists(SiteSeoResource::class)) {
                            return null;
                        }

                        $seoId = SiteSeo::query()
                            ->where('seoable_type', JobListing::class)
                            ->where('seoable_id', $record->getKey())
                            ->value('id');

                        if (! is_numeric($seoId)) {
                            return null;
                        }

                        return SiteSeoResource::getUrl('edit', ['record' => (int) $seoId]);
                    })
                    ->visible(fn (): bool => class_exists(SiteSeo::class) && class_exists(SiteSeoResource::class)),
                Action::make('view')
                    ->label('View public')
                    ->url(fn (JobListing $record): string => route('careers.show', $record->slug))
                    ->openUrlInNewTab(),
            ])
            ->filters([
                SelectFilter::make('job_type')
                    ->label('Job type')
                    ->options([
                        'full-time' => 'Full-time',
                        'part-time' => 'Part-time',
                        'contract' => 'Contract',
                        'remote' => 'Remote',
                    ]),
                TrashedFilter::make(),
            ])
            ->toolbarActions([
                DeleteBulkAction::make(),
                ForceDeleteBulkAction::make(),
                RestoreBulkAction::make(),
            ]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListJobListings::route('/'),
            'create' => Pages\CreateJobListing::route('/create'),
            'edit' => Pages\EditJobListing::route('/{record}/edit'),
        ];
    }

    public static function getEloquentQuery(): Builder
    {
        return parent::getEloquentQuery()->withoutGlobalScopes([
            \Illuminate\Database\Eloquent\SoftDeletingScope::class,
        ]);
    }
