{{-- Generated by Starter Package --}}
<x-layout>
    @push('seo')
        <title>{{ $job->meta_title ?: $job->title }}</title>
        @if ($job->meta_description)
            <meta name="description" content="{{ $job->meta_description }}">
        @endif
        @if (is_array($job->meta_keywords) && count($job->meta_keywords) > 0)
            <meta name="keywords" content="{{ implode(',', $job->meta_keywords) }}">
        @endif
        @php
            $ogUrl = $job->getFirstMediaUrl('og');
        @endphp
        @if ($ogUrl)
            <meta property="og:image" content="{{ $ogUrl }}">
        @endif
        @if ($job->meta_structure)
            @php
                $schemas = $job->meta_structure;
                $schemaList = is_array($schemas) && array_is_list($schemas) ? $schemas : [$schemas];
            @endphp
            @foreach ($schemaList as $schema)
                @php
                    $schemaJson = is_string($schema)
                        ? $schema
                        : json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
                @endphp
                @if ($schemaJson)
                    <script type="application/ld+json">
                        {!! $schemaJson !!}
                    </script>
                @endif
            @endforeach
        @endif
    @endpush

    <article>
        <h1>{{ $job->title }}</h1>
        <div>
            @if ($job->job_type)
                <span>{{ $job->job_type }}</span>
            @endif
            @if ($job->job_location)
                <span>{{ $job->job_location }}</span>
            @endif
            @if ($job->experience)
                <span>{{ $job->experience }}</span>
            @endif
        </div>

        @if ($job->description)
            <div>
                {!! $job->description !!}
            </div>
        @endif

        @if ($job->external_link)
            <p>
                <a href="{{ $job->external_link }}" target="_blank" rel="noopener">Apply now</a>
            </p>
        @else
            <livewire:careers.apply-job :slug="$job->slug" />
        @endif
    </article>
</x-layout>
