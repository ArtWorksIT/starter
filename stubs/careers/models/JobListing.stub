<?php

// Generated by Starter Package

namespace App\Models;

use App\Models\Concerns\HasSeoMorph;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\SoftDeletes;

class JobListing extends Model
{
    use HasSeoMorph;
    use SoftDeletes;

    /**
     * @var list<string>
     */
    protected $fillable = [
        'enabled',
        'title',
        'slug',
        'experience',
        'job_location',
        'job_type',
        'description',
        'external_link',
        'sort_order',
    ];

    public function submissions(): HasMany
    {
        return $this->hasMany(JobSubmission::class);
    }

    protected function seoUrl(): ?string
    {
        if ($this->slug === '') {
            return null;
        }

        return '/careers/'.$this->slug;
    }
}
