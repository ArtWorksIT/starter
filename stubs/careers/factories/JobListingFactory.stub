 */
class JobListingFactory extends Factory
{
    protected $model = JobListing::class;

    /**
     * @return array<string, mixed>
     */
    public function definition(): array
    {
        $title = fake()->jobTitle();

        return [
            'enabled' => fake()->boolean(80),
            'title' => $title,
            'slug' => Str::slug($title . '-' . fake()->unique()->numerify('###')),
            'experience' => fake()->randomElement(['Entry Level', 'Mid Level', 'Senior', 'Lead', 'Manager']),
            'job_location' => fake()->randomElement([
                'Remote',
                'Hybrid - ' . fake()->city(),
                fake()->city() . ', ' . fake()->countryCode(),
            ]),
            'job_type' => fake()->randomElement(['Full-time', 'Part-time', 'Contract', 'Freelance', 'Internship']),
            'description' => '<p>' . implode('</p><p>', fake()->paragraphs(3)) . '</p>',
            'external_link' => fake()->optional(0.5)->url(),
            'sort_order' => fake()->numberBetween(0, 100),
            'published_at' => fake()->optional(0.8)->dateTimeBetween('-6 months', 'now'),
        ];
    }

    public function published(): static
    {
        return $this->state(fn (array $attributes): array => [
            'published_at' => fake()->dateTimeBetween('-6 months', 'now'),
        ]);
    }

    public function draft(): static
    {
        return $this->state(fn (array $attributes): array => [
            'published_at' => null,
        ]);
    }

    public function enabled(): static
    {
        return $this->state(fn (array $attributes): array => [
            'enabled' => true,
        ]);
    }

    public function disabled(): static
    {
        return $this->state(fn (array $attributes): array => [
            'enabled' => false,
        ]);
    }
