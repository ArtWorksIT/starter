<?php

// Generated by Starter Package

namespace App\Http\Controllers;

use App\Models\JobListing;
use Filament\Facades\Filament;
use Illuminate\View\View;

class JobController extends Controller
{
    public function index(): View
    {
        $jobs = JobListing::query()
            ->where('enabled', true)
            ->orderBy('sort_order')
            ->orderByDesc('created_at')
            ->get();

        return view('careers.index', compact('jobs'));
    }

    public function show(string $slug): View
    {
        $job = JobListing::query()
            ->where('slug', $slug)
            ->where('enabled', true)
            ->firstOrFail();

        return view('careers.show', compact('job'));
    }

    public function preview(string $slug): View
    {
        abort_unless(auth()->user()?->canAccessPanel(Filament::getPanel('admin')), 403);

        $job = JobListing::query()
            ->where('slug', $slug)
            ->firstOrFail();

        return view('careers.show', compact('job'));
    }
}
