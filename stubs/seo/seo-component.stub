{{-- Generated by Starter Package --}}
@php
    use App\Models\SiteSeo;

    $path = request()->path();
    $url = $path === '/' ? '/' : '/'.$path;
    $seo = SiteSeo::query()->where('url', $url)->first();
@endphp

@if ($seo)
    @php
        $metaTitle = $seo->meta_title;
        $metaDescription = $seo->meta_description;
        $metaUrl = url()->current();
        $ogImage = $seo->getFirstMediaUrl('og');
    @endphp

    @if ($metaTitle)
        <title>{{ $seo->meta_title }}</title>
    @endif

    @if ($metaDescription)
        <meta name="description" content="{{ $seo->meta_description }}">
    @endif

    @if (!empty($seo->meta_keywords))
        <meta name="keywords" content="{{ implode(',', $seo->meta_keywords) }}">
    @endif

    @if ($seo->meta_structure)
        @php
            $schemas = $seo->meta_structure;
            $schemaList = is_array($schemas) && array_is_list($schemas) ? $schemas : [$schemas];
        @endphp
        @foreach ($schemaList as $schema)
            @php
                $schemaJson = is_string($schema)
                    ? $schema
                    : json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT);
            @endphp
            @if ($schemaJson)
                <script type="application/ld+json">
                    {!! $schemaJson !!}
                </script>
            @endif
        @endforeach
    @endif

    @if ($metaTitle)
        <meta property="og:title" content="{{ $metaTitle }}">
    @endif

    @if ($metaDescription)
        <meta property="og:description" content="{{ $metaDescription }}">
    @endif

    <meta property="og:type" content="website">

    @if ($metaUrl)
        <meta property="og:url" content="{{ $metaUrl }}">
    @endif

    @if ($ogImage)
        <meta property="og:image" content="{{ $ogImage }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:image" content="{{ $ogImage }}">
    @else
        <meta name="twitter:card" content="summary">
    @endif

    @if ($metaTitle)
        <meta name="twitter:title" content="{{ $metaTitle }}">
    @endif

    @if ($metaDescription)
        <meta name="twitter:description" content="{{ $metaDescription }}">
    @endif
@endif
