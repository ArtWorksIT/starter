            $existingForUrl = SiteSeo::query()->where('url', $url)->first();

            if ($existingForUrl instanceof SiteSeo) {
                $isCurrentRecord = $existingForUrl->seoable_type === $model::class
                    && (int) $existingForUrl->seoable_id === (int) $model->getKey();

                $isStaticRecord = $existingForUrl->seoable_type === null
