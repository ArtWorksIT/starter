                if (! $isCurrentRecord && ! $isStaticRecord) {
                    return;
                }

                if ($isStaticRecord) {
                    $existingForUrl->seoable_type = $model::class;
                    $existingForUrl->seoable_id = $model->getKey();
                    $existingForUrl->save();

                    return;
                }
            }

