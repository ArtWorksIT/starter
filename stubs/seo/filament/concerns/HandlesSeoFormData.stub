<?php

// Generated by Starter Package

namespace App\Filament\Resources\Concerns;

use App\Models\SiteSeo;
use Illuminate\Support\Facades\Storage;

trait HandlesSeoFormData
{
    /**
     * @var array<string, mixed>
     */
    protected array $seoData = [];

    /**
     * @param array<string, mixed> $data
     * @return array<string, mixed>
     */
    protected function extractSeoData(array $data): array
    {
        return [
            'meta_title' => $data['seo_meta_title'] ?? null,
            'meta_description' => $data['seo_meta_description'] ?? null,
            'meta_keywords' => $data['seo_meta_keywords'] ?? null,
            'meta_structure' => $data['seo_meta_structure'] ?? null,
            'og_image' => $data['seo_og_image'] ?? null,
        ];
    }

    /**
     * @param array<string, mixed> $data
     * @return array<string, mixed>
     */
    protected function stripSeoFields(array $data): array
    {
        unset(
            $data['seo_meta_title'],
            $data['seo_meta_description'],
            $data['seo_meta_keywords'],
            $data['seo_meta_structure'],
            $data['seo_og_image'],
        );

        return $data;
    }

    /**
     * @param array<string, mixed> $data
     * @return array<string, mixed>
     */
    protected function fillSeoDataFromRecord(array $data): array
    {
        $seo = $this->record->seo;

        $data['seo_meta_title'] = $seo?->meta_title;
        $data['seo_meta_description'] = $seo?->meta_description;
        $data['seo_meta_keywords'] = $seo?->meta_keywords;
        $data['seo_meta_structure'] = $seo?->meta_structure;
        $data['seo_og_image'] = $seo?->getFirstMedia('og')?->getPathRelativeToRoot();

        return $data;
    }

    /**
     * @return array<string, mixed>
     */
    protected function seoAttributes(): array
    {
        return [
            'meta_title' => $this->seoData['meta_title'] ?? null,
            'meta_description' => $this->seoData['meta_description'] ?? null,
            'meta_keywords' => $this->seoData['meta_keywords'] ?? null,
            'meta_structure' => $this->seoData['meta_structure'] ?? null,
        ];
    }

    protected function syncSeoForUrl(?string $url): void
    {
        if ($url === null || $url === '' || ! class_exists(SiteSeo::class)) {
            return;
        }

        $seo = $this->record->seo()->updateOrCreate([], [
            'url' => $url,
            ...$this->seoAttributes(),
        ]);

        $this->syncSeoOgImage($seo, $this->seoData['og_image'] ?? null);
    }

    protected function seoUrlFromSlug(string $prefix): ?string
    {
        $slug = (string) $this->record->slug;

        if ($slug === '') {
            return null;
        }

        return $prefix.'/'.$slug;
    }

    protected function syncSeoOgImage(SiteSeo $seo, mixed $path): void
    {
        if (! is_string($path) || $path === '' || ! Storage::disk('public')->exists($path)) {
            return;
        }

        $currentPath = $seo->getFirstMedia('og')?->getPathRelativeToRoot();

        if ($currentPath === $path) {
            return;
        }

        $seo->clearMediaCollection('og');
        $seo->addMediaFromDisk($path, 'public')->toMediaCollection('og');
    }
}
