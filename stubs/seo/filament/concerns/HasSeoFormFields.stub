<?php

// Generated by Starter Package

namespace App\Filament\Resources\Concerns;

use Filament\Forms\Components\FileUpload;
use Filament\Forms\Components\Repeater;
use Filament\Forms\Components\TagsInput;
use Filament\Forms\Components\Textarea;
use Filament\Forms\Components\TextInput;

trait HasSeoFormFields
{
    /**
     * @return array<int, mixed>
     */
    protected static function seoTabSchema(): array
    {
        $metaDescription = Textarea::make('seo_meta_description')
            ->label('Meta description')
            ->rows(3)
            ->columnSpanFull();

        $descriptionHelperText = static::seoDescriptionHelperText();

        if (is_string($descriptionHelperText) && $descriptionHelperText !== '') {
            $metaDescription->helperText($descriptionHelperText);
        }

        return [
            TextInput::make('seo_meta_title')
                ->label('Meta title')
                ->helperText('Defaults to title when empty.'),
            $metaDescription,
            TagsInput::make('seo_meta_keywords')
                ->label('Meta keywords'),
            Repeater::make('seo_meta_structure')
                ->label('Meta structure')
                ->simple(
                    Textarea::make('schema')
                        ->rows(6)
                        ->helperText('One JSON-LD schema per item.')
                        ->columnSpanFull(),
                )
                ->columnSpanFull(),
            FileUpload::make('seo_og_image')
                ->label('OG image')
                ->disk('public')
                ->directory('seo-og')
                ->helperText('Recommended size: 1200x630 (1200:630).')
                ->image()
                ->imageEditor()
                ->imageEditorAspectRatioOptions(['1200:630'])
                ->columnSpanFull(),
        ];
    }

    protected static function seoDescriptionHelperText(): ?string
    {
        return null;
    }
}
