<?php

// Generated by Starter Package

namespace App\Filament\Actions;

use App\Filament\Actions\Concerns\ValidatesPublishable;
use Filament\Actions\Action;
use Filament\Notifications\Notification;
use Illuminate\Database\Eloquent\Model;

class TogglePublishAction extends Action
{
    use ValidatesPublishable;

    public static function getDefaultName(): ?string
    {
        return 'toggle-publish';
    }

    protected function setUp(): void
    {
        parent::setUp();

        $this->name('toggle-publish');

        $this->label(fn (Model $record): string =>
            $record->isPublished() ? 'Unpublish' : 'Publish'
        );

        $this->icon(fn (Model $record): string =>
            $record->isPublished()
                ? 'heroicon-o-arrow-down-circle'
                : 'heroicon-o-arrow-up-circle'
        );

        $this->color(fn (Model $record): string =>
            $record->isPublished() ? 'warning' : 'success'
        );

        $this->requiresConfirmation();

        $this->modalHeading(fn (Model $record): string =>
            $record->isPublished()
                ? 'Unpublish this record?'
                : 'Publish this record?'
        );

        $this->modalDescription(fn (Model $record): string =>
            $record->isPublished()
                ? 'This will hide the record from public view.'
                : 'This will make the record publicly visible.'
        );

        $this->modalSubmitActionLabel(fn (Model $record): string =>
            $record->isPublished() ? 'Yes, unpublish' : 'Yes, publish'
        );

        $this->action(function (Model $record): void {
            $this->ensurePublishable($record);

            $wasPublished = $record->isPublished();

            $wasPublished ? $record->unpublish() : $record->publish();

            Notification::make()
                ->success()
                ->title($wasPublished ? 'Unpublished' : 'Published')
                ->body($wasPublished
                    ? 'Record has been moved to draft.'
                    : 'Record is now live.'
                )
                ->send();
        });
    }
}
