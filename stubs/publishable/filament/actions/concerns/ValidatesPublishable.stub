namespace App\Filament\Actions\Concerns;

use Exception;
use Illuminate\Database\Eloquent\Model;

trait ValidatesPublishable
{
    protected function ensurePublishable(Model $record): void
    {
        if (! method_exists($record, 'isPublished')) {
            throw new Exception(sprintf(
                'Model [%s] must use the Publishable trait to use this action.',
                get_class($record)
            ));
        }

        if (
            ! in_array('published_at', $record->getFillable()) &&
            ! $record->getConnection()->getSchemaBuilder()->hasColumn($record->getTable(), 'published_at')
        ) {
            throw new Exception(sprintf(
                'Model [%s] is missing the published_at column. Add $table->publishable() to your migration.',
                get_class($record)
            ));
        }
    }
}
