{
  "name": "artworksit/starter",
  "description": "Website starter scaffolding package for Laravel projects.",
  "version": "0.1.5",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "starter",
    "scaffold",
    "website",
    "artworksit"
  ],
  "homepage": "https://github.com/ArtWorksIT/starter",
  "support": {
    "issues": "https://github.com/ArtWorksIT/starter/issues",
    "source": "https://github.com/ArtWorksIT/starter"
  },
  "authors": [
    {
      "name": "Ashwin",
      "email": "ashwin@artworksit.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0",
    "intervention/image": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Artworksit\\Starter\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Artworksit\\Starter\\StarterServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
